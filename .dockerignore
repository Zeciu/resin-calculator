# VCS
.git
.gitignore

# Local secrets and environment overrides (production VITE_* must come from build ARG/ENV only)
frontend/.env.local
frontend/.env.*.local
**/.env.local
**/.env.*.local
.env
**/.env

# Dependencies
**/node_modules
frontend/node_modules
backend/.venv
.venv
**/__pycache__
**/*.py[cod]
**/*.egg-info

# Test and coverage caches
**/.pytest_cache
**/.coverage
**/coverage
**/htmlcov
frontend/coverage
backend/.pytest_cache

# Local frontend build output (image rebuilds from source)
frontend/dist

# CDK generated artifacts
deployment/cdk/cdk.out
deployment/cdk/dist
deployment/cdk/node_modules

# IDE / editor
.idea
.vscode
.cursor
.kiro
*.swp
*.swo
*~

# Temporary files and logs
*.log
**/*.log
tmp
temp
*.tmp
.DS_Store
Thumbs.db

# Documentation and local-only artifacts not required by Dockerfile
documentation
PROJECT_STATUS.md
README.md
dev.cmd
test.cmd
test
changed-files.txt

# Local editorial data is never part of the production build context. The
# production reader serves the released public corpus under backend/public/content.
backend/data/

# Local-only editorial/admin source. Dockerfiles must also use explicit public allowlists.
frontend/private/
backend/private/

backend/content/routers/admin_*.py
backend/content/routers/generate_translation.py
backend/content/translation/
