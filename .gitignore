# backend/private/content — editorial source of truth (published copies go to backend/public/content).
# Ignore commercial/user/runtime by default; track the approved editorial corpus only.
backend/private/content/*
!backend/private/content/editorial/
backend/private/content/editorial/*
!backend/private/content/editorial/content-store.json
!backend/private/content/published/
backend/private/content/published/*
!backend/private/content/published/manual/
!backend/private/content/published/manual/**
!backend/private/content/published/glossary/
!backend/private/content/published/glossary/**
!backend/private/content/published/knowledge-base/
!backend/private/content/published/knowledge-base/**
!backend/private/content/published/website/
!backend/private/content/published/website/**
!backend/private/content/manual/
backend/private/content/manual/*
!backend/private/content/manual/images/
!backend/private/content/manual/images/**
!backend/private/content/glossary/
backend/private/content/glossary/*
!backend/private/content/glossary/images/
!backend/private/content/glossary/images/**
!backend/private/content/knowledge-base/
backend/private/content/knowledge-base/*
!backend/private/content/knowledge-base/images/
!backend/private/content/knowledge-base/images/**
!backend/private/content/website/
backend/private/content/website/*
!backend/private/content/website/images/
!backend/private/content/website/images/**
!backend/private/content/config/
backend/private/content/config/*
!backend/private/content/config/public-languages.json
!backend/private/content/config/free-preview.json
!backend/private/content/config/public-preview.json

# Keep commercial/user/runtime artifacts ignored (even if paths appear under private/content/)
backend/private/content/entitlements/
backend/private/content/**/*.tmp*

# Local-only editorial/admin source is tracked, but never included in production Docker builds.
# See frontend/private/README.md and backend/private/README.md.
/frontend/public/node_modules/

# Local runtime / probe junk that must never ship.
/node_modules/
/.tmp-probe/
/backend/data/
/backend/public/content/editorial/
